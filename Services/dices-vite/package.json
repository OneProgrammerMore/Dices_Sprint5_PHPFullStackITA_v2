{
  "name": "dices-vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint 'src/**/*.{js,ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{js,ts,tsx}' --fix",
    "preview": "vite preview",
    "prettier-format": "prettier --config .prettierrc 'src/**/*.{ts,tsx}' --write",
    "test": "vitest --config vitest.config.js",
    "testb": "vitest --config vitest-browser.config.js",
    "test-browser": "playwright test --reporter=html",
    "show-test-browser-report": "playwright show-report --port=9323",
    "test-browser-headed": "playwright test --headed --reporter=html"
  },
  "dependencies": {
    "@playwright/test": "^1.47.2",
    "@reduxjs/toolkit": "^2.5.0",
    "@types/react-loading-indicator": "^1.0.3",
    "@types/react-query": "^1.2.9",
    "@types/react-redux": "^7.1.34",
    "@types/yup": "^0.32.0",
    "playwright": "^1.47.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-loading-indicators": "^1.0.0",
    "react-query": "^3.39.3",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "three": "^0.167.1",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^7.0.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.167.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/browser": "^3.0.2",
    "@vitest/coverage-v8": "^3.0.2",
    "eslint": "^8.57.1",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-etc": "^2.0.3",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^5.4.11",
    "vite-plugin-css": "^1.0.4",
    "vitest": "^3.0.2"
  }
}
